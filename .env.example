# Supabase project (public — safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose to the browser, NEVER commit real values.
SUPABASE_SERVICE_ROLE_KEY=

# Bootstrap Management account (§5.5). Used once by scripts/bootstrap-admin.ts,
# then the script self-disables. Never commit real values.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
